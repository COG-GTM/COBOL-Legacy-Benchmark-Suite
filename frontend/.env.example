# Copy to .env.local and adjust to point the UI at a real backend.
# mock | real
VITE_API_MODE=real
# Base path (or absolute URL) of the REST API defined in section 7.1 of the FR doc.
VITE_API_BASE_URL=/api/v1
# Dev server only: proxy /api to this origin (avoids CORS while developing).
VITE_API_PROXY_TARGET=http://localhost:8080
# Optional: where "Sign in" and "Exit" send the browser (e.g. your OIDC provider).
VITE_AUTH_LOGIN_URL=
VITE_AUTH_LOGOUT_URL=
