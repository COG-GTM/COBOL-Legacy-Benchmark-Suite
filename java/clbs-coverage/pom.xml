<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.cognition.clbs</groupId>
    <artifactId>clbs-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>clbs-coverage</artifactId>
  <packaging>pom</packaging>
  <name>CLBS :: Coverage Report</name>
  <description>
    Aggregates JaCoCo execution data from every module into one report
    (target/site/jacoco-aggregate). The per-module coverage floor is enforced by the
    parent's jacoco:check execution.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.cognition.clbs</groupId>
      <artifactId>clbs-test-harness</artifactId>
    </dependency>
    <dependency>
      <groupId>com.cognition.clbs</groupId>
      <artifactId>clbs-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.cognition.clbs</groupId>
      <artifactId>clbs-portfolio</artifactId>
    </dependency>
    <dependency>
      <groupId>com.cognition.clbs</groupId>
      <artifactId>clbs-batch</artifactId>
    </dependency>
    <dependency>
      <groupId>com.cognition.clbs</groupId>
      <artifactId>clbs-online</artifactId>
    </dependency>
    <dependency>
      <groupId>com.cognition.clbs</groupId>
      <artifactId>clbs-reporting</artifactId>
    </dependency>
    <dependency>
      <groupId>com.cognition.clbs</groupId>
      <artifactId>clbs-utility</artifactId>
    </dependency>
    <dependency>
      <groupId>com.cognition.clbs</groupId>
      <artifactId>clbs-app</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
