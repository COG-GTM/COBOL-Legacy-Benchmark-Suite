{
  "name": "cobol-legacy-benchmark-suite",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "npm run prisma:migrate --workspace=packages/backend",
    "db:seed": "npm run prisma:seed --workspace=packages/backend"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.20.0"
  }
}
