generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Maps from PORTFOLIO_MASTER table (DB2)
// Copybook: PORTFLIO.cpy
model Portfolio {
  portfolioId   String    @id @map("portfolio_id") @db.Char(8)
  accountType   String    @map("account_type") @db.Char(2)
  branchId      String    @map("branch_id") @db.Char(2)
  clientId      String    @map("client_id") @db.Char(10)
  portfolioName String    @map("portfolio_name") @db.VarChar(50)
  currencyCode  String    @map("currency_code") @db.Char(3)
  riskLevel     String    @map("risk_level") @db.Char(1)
  status        String    @map("status") @db.Char(1)  // A=Active, C=Closed, S=Suspended
  openDate      DateTime  @map("open_date") @db.Date
  closeDate     DateTime? @map("close_date") @db.Date
  lastMaintDate DateTime  @map("last_maint_date") @db.Timestamp()
  lastMaintUser String    @map("last_maint_user") @db.VarChar(8)
  totalValue    Decimal   @default(0) @map("total_value") @db.Decimal(15, 2)
  cashBalance   Decimal   @default(0) @map("cash_balance") @db.Decimal(15, 2)

  positions    InvestmentPosition[]
  transactions Transaction[]
  auditLogs    AuditLog[]

  @@index([clientId, status], name: "idx_port_master_client")
  @@map("portfolio_master")
}

// Maps from INVESTMENT_POSITIONS table (DB2)
// Copybook: POSREC.cpy
model InvestmentPosition {
  portfolioId  String   @map("portfolio_id") @db.Char(8)
  investmentId String   @map("investment_id") @db.Char(10)
  positionDate DateTime @map("position_date") @db.Date
  quantity     Decimal  @map("quantity") @db.Decimal(18, 4)
  costBasis    Decimal  @map("cost_basis") @db.Decimal(18, 2)
  marketValue  Decimal  @map("market_value") @db.Decimal(18, 2)
  currencyCode String   @map("currency_code") @db.Char(3)
  lastMaintDate DateTime @map("last_maint_date") @db.Timestamp()
  lastMaintUser String   @map("last_maint_user") @db.VarChar(8)

  portfolio Portfolio @relation(fields: [portfolioId], references: [portfolioId])

  @@id([portfolioId, investmentId, positionDate])
  @@index([positionDate, portfolioId], name: "idx_positions_date")
  @@map("investment_positions")
}

// Maps from TRANSACTION_HISTORY table (DB2)
// Copybook: TRNREC.cpy
model Transaction {
  transactionId   String   @id @map("transaction_id") @db.Char(20)
  portfolioId     String   @map("portfolio_id") @db.Char(8)
  transactionDate DateTime @map("transaction_date") @db.Date
  transactionTime String   @map("transaction_time") @db.VarChar(8) // HH:MM:SS
  investmentId    String   @map("investment_id") @db.Char(10)
  transactionType String   @map("transaction_type") @db.Char(2) // BU/SL/TR/FE
  quantity        Decimal  @map("quantity") @db.Decimal(18, 4)
  price           Decimal  @map("price") @db.Decimal(18, 4)
  amount          Decimal  @map("amount") @db.Decimal(18, 2)
  currencyCode    String   @map("currency_code") @db.Char(3)
  status          String   @map("status") @db.Char(1) // P=Pending, D=Done, F=Failed, R=Reversed
  processDate     DateTime @map("process_date") @db.Timestamp()
  processUser     String   @map("process_user") @db.VarChar(8)

  portfolio Portfolio @relation(fields: [portfolioId], references: [portfolioId])

  @@index([portfolioId, transactionDate], name: "idx_trans_hist_port")
  @@index([transactionDate, portfolioId], name: "idx_trans_hist_date")
  @@map("transaction_history")
}

// Maps from POSHIST table (DB2)
model PositionHistory {
  id             Int      @id @default(autoincrement())
  accountNo      String   @map("account_no") @db.Char(8)
  portfolioId    String   @map("portfolio_id") @db.Char(10)
  transDate      DateTime @map("trans_date") @db.Date
  transTime      String   @map("trans_time") @db.VarChar(8)
  transType      String   @map("trans_type") @db.Char(2)
  securityId     String   @map("security_id") @db.Char(12)
  quantity       Decimal  @map("quantity") @db.Decimal(15, 3)
  price          Decimal  @map("price") @db.Decimal(15, 3)
  amount         Decimal  @map("amount") @db.Decimal(15, 2)
  fees           Decimal  @default(0) @map("fees") @db.Decimal(15, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(15, 2)
  costBasis      Decimal  @map("cost_basis") @db.Decimal(15, 2)
  gainLoss       Decimal  @map("gain_loss") @db.Decimal(15, 2)
  processDate    DateTime @map("process_date") @db.Date
  processTime    String   @map("process_time") @db.VarChar(8)
  programId      String   @map("program_id") @db.Char(8)
  userId         String   @map("user_id") @db.Char(8)
  auditTimestamp DateTime @default(now()) @map("audit_timestamp") @db.Timestamp()

  @@unique([accountNo, portfolioId, transDate, transTime])
  @@index([securityId, transDate])
  @@index([processDate, programId])
  @@map("position_history")
}

// Maps from HISTREC copybook — audit log
model AuditLog {
  id           Int      @id @default(autoincrement())
  portfolioId  String   @map("portfolio_id") @db.Char(8)
  date         DateTime @map("date") @db.Date
  time         String   @map("time") @db.VarChar(6)
  seqNo        String   @map("seq_no") @db.VarChar(4)
  recordType   String   @map("record_type") @db.Char(2) // PT=Portfolio, PS=Position, TR=Transaction
  actionCode   String   @map("action_code") @db.Char(1) // A=Add, C=Change, D=Delete
  beforeImage  String?  @map("before_image") @db.Text
  afterImage   String?  @map("after_image") @db.Text
  reasonCode   String?  @map("reason_code") @db.VarChar(4)
  processDate  DateTime @map("process_date") @db.Timestamp()
  processUser  String   @map("process_user") @db.VarChar(8)

  portfolio Portfolio @relation(fields: [portfolioId], references: [portfolioId])

  @@index([portfolioId, date])
  @@map("audit_log")
}

// Batch job control — maps from BCHCTL copybook
model BatchJob {
  id           Int      @id @default(autoincrement())
  jobName      String   @map("job_name") @db.VarChar(8)
  processDate  DateTime @map("process_date") @db.Date
  sequenceNo   Int      @map("sequence_no")
  status       String   @map("status") @db.Char(1) // R=Ready, A=Active, W=Waiting, D=Done, E=Error
  stepName     String?  @map("step_name") @db.VarChar(8)
  programName  String?  @map("program_name") @db.VarChar(8)
  startTime    DateTime? @map("start_time") @db.Timestamp()
  endTime      DateTime? @map("end_time") @db.Timestamp()
  returnCode   Int?     @map("return_code")
  errorDesc    String?  @map("error_desc") @db.VarChar(255)
  recordsRead  Int      @default(0) @map("records_read")
  recordsWritten Int    @default(0) @map("records_written")
  errorCount   Int      @default(0) @map("error_count")

  @@unique([jobName, processDate, sequenceNo])
  @@map("batch_jobs")
}

// User table for JWT auth — maps from SECMGR logic
model User {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(8)
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  role      String   @default("user") @db.VarChar(20) // admin, user, viewer
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
