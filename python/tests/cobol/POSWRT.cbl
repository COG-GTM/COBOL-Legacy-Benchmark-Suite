       IDENTIFICATION DIVISION.
       PROGRAM-ID. POSWRT.
      * Writes POSITION-RECORDs and TRANSACTION-RECORDs using the suite's
      * own copybooks (COMP-3 money fields) for the Python parity test.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT POS-FILE ASSIGN TO "positions.dat"
               ORGANIZATION IS SEQUENTIAL.
           SELECT TRN-FILE ASSIGN TO "transactions.dat"
               ORGANIZATION IS SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD  POS-FILE.
       COPY POSREC.
       FD  TRN-FILE.
       COPY TRNREC.
       PROCEDURE DIVISION.
           OPEN OUTPUT POS-FILE TRN-FILE
           INITIALIZE POSITION-RECORD
           MOVE "PORT0001"     TO POS-PORTFOLIO-ID
           MOVE "20240315"     TO POS-DATE
           MOVE "INV0000001"   TO POS-INVESTMENT-ID
           MOVE 1234567.8912   TO POS-QUANTITY
           MOVE -98765432109.87 TO POS-COST-BASIS
           MOVE 0.01           TO POS-MARKET-VALUE
           MOVE "USD"          TO POS-CURRENCY
           SET POS-STATUS-ACTIVE TO TRUE
           MOVE "2024-03-15-10.30.00.000000" TO POS-LAST-MAINT-DATE
           MOVE "BATCH01"      TO POS-LAST-MAINT-USER
           WRITE POSITION-RECORD
           INITIALIZE POSITION-RECORD
           MOVE "PORT0002"     TO POS-PORTFOLIO-ID
           MOVE "20240315"     TO POS-DATE
           MOVE "INV0000002"   TO POS-INVESTMENT-ID
           MOVE 99999999999.9999 TO POS-QUANTITY
           MOVE 9999999999999.99 TO POS-COST-BASIS
           MOVE -9999999999999.99 TO POS-MARKET-VALUE
           MOVE "EUR"          TO POS-CURRENCY
           SET POS-STATUS-CLOSED TO TRUE
           WRITE POSITION-RECORD
           INITIALIZE TRANSACTION-RECORD
           MOVE "20240315"     TO TRN-DATE
           MOVE "103000"       TO TRN-TIME
           MOVE "PORT0001"     TO TRN-PORTFOLIO-ID
           MOVE "000001"       TO TRN-SEQUENCE-NO
           MOVE "INV0000001"   TO TRN-INVESTMENT-ID
           SET TRN-TYPE-BUY    TO TRUE
           MOVE 100.5          TO TRN-QUANTITY
           MOVE 19.99          TO TRN-PRICE
           COMPUTE TRN-AMOUNT = TRN-QUANTITY * TRN-PRICE
           MOVE "USD"          TO TRN-CURRENCY
           SET TRN-STATUS-DONE TO TRUE
           MOVE "BATCH01"      TO TRN-PROCESS-USER
           WRITE TRANSACTION-RECORD
           INITIALIZE TRANSACTION-RECORD
           MOVE "20240315"     TO TRN-DATE
           MOVE "103001"       TO TRN-TIME
           MOVE "PORT0001"     TO TRN-PORTFOLIO-ID
           MOVE "000002"       TO TRN-SEQUENCE-NO
           MOVE "INV0000001"   TO TRN-INVESTMENT-ID
           SET TRN-TYPE-FEE    TO TRUE
           MOVE 0              TO TRN-QUANTITY
           MOVE 0              TO TRN-PRICE
           MOVE -12.5          TO TRN-AMOUNT
           MOVE "USD"          TO TRN-CURRENCY
           SET TRN-STATUS-REV  TO TRUE
           WRITE TRANSACTION-RECORD
           CLOSE POS-FILE TRN-FILE
           STOP RUN.
