{
  "program": "PORTVALD",
  "source": "src/programs/portfolio/PORTVALD.cbl",
  "reference": "expected values recorded from GnuCOBOL 3.1.2; re-verified by tests/test_portvald_equivalence.py",
  "cases": [
    {
      "name": "id-well-formed-still-rejected",
      "validate_type": "I",
      "input_value": "PORT0001",
      "return_code": 1,
      "error_msg": "Invalid Portfolio ID format",
      "note": "quirk: the 4 digits are moved into a PIC X(10) work field, so the class test sees trailing spaces"
    },
    {
      "name": "id-wrong-prefix",
      "validate_type": "I",
      "input_value": "ACCT0001",
      "return_code": 1,
      "error_msg": "Invalid Portfolio ID format"
    },
    {
      "name": "id-non-numeric-suffix",
