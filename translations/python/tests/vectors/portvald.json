      "input_value": "PORTABCD",
      "return_code": 1,
      "error_msg": "Invalid Portfolio ID format"
    },
    {
      "name": "id-empty",
      "validate_type": "I",
      "input_value": "",
      "return_code": 1,
      "error_msg": "Invalid Portfolio ID format"
    },
    {
      "name": "account-ten-digits-still-rejected",
