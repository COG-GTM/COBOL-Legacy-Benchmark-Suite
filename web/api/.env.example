# Port the API listens on
PORT=4000

# Data layer selection: "memory" (default, seeded sample data) or "db2".
# The "db2" driver is a documented stub — see web/README.md for how to wire it
# up against a real DB2 instance using the connection settings below.
DATA_SOURCE=memory

# DB2 connection settings (only used when DATA_SOURCE=db2)
DB2_DATABASE=PORTDB
DB2_HOSTNAME=localhost
DB2_PORT=50000
DB2_UID=db2inst1
DB2_PWD=changeme
